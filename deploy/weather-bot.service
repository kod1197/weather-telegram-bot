[Unit]
Description=Weather Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=weatherbot
Group=weatherbot
WorkingDirectory=/opt/weather-bot
EnvironmentFile=/etc/weather-bot.env
ExecStart=/usr/bin/python3 /opt/weather-bot/bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/weather-bot

[Install]
WantedBy=multi-user.target
